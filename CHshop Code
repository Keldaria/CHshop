	!this will be displayed as version 1.2, fix3.
	!if you input 40500, will be showen as version 4.5
	
	$mod_info[2] = 'Kelly'
	!2=mod author
	
	$mod_info[3] = 'Adds a cheat shop to the pavlovsk bedroom that can be enabled through the cheat menu. The shop does not limit what clothing is available for easy initial game setup. Clothing purchases are still impacted by inhibition and available money but you can modify those using the cheat menu as well. The intent is to make it easier to customize initial game setups'
	!3=mod description, input a short brief here.
	
	if $curloc = 'mod_<<$mod_info[0]>>_setup':
